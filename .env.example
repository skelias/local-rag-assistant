# 复制此文件为 .env 并填入你的密钥（.env 已被 gitignore，不会进 git）

# ---- LLM API Keys：有哪个就填哪个，没填的在设置里不可选 ----
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxx        # Anthropic（原生）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx          # DeepSeek（OpenAI 兼容）
OPENAI_API_KEY=sk-xxxxxxxxxxxxx            # OpenAI GPT（OpenAI 兼容）
GLM_API_KEY=sk-xxxxxxxxxxxxx               # 智谱 GLM（OpenAI 兼容）
KIMI_API_KEY=sk-xxxxxxxxxxxxx              # Kimi/Moonshot（OpenAI 兼容）

# ---- 兼容端点 base_url（一般不用改；有自建网关/代理才需要覆盖）----
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- 默认模型：谁是主力、谁是备胎 ----
DEFAULT_CHAT_PROVIDER=anthropic            # anthropic | deepseek | glm | kimi | openai
DEFAULT_CHAT_MODEL=claude-sonnet-4-5       # 按你账号实际可用模型填
FALLBACK_CHAT_PROVIDER=deepseek
FALLBACK_CHAT_MODEL=deepseek-chat

DEFAULT_EMBEDDING_MODEL=bge-m3              # 预留，P0-4 用
